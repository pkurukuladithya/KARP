{
  "network": {
    "laptop_ip": "127.0.0.1",
    "pi_ip": "127.0.0.1",
    "video_port_pi_to_laptop": 5000,
    "video_port_laptop_to_pi": 5001,
    "metadata_ws_port": 8765,
    "discovery_port": 5005
  },
  "video": {
    "camera_index": 0,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "bitrate": 2500000,
    "jpeg_quality": 75,
    "stream_width": 960,
    "stream_height": 540
  },
  "vision": {
    "confidence_threshold": 0.45,
    "iou_threshold": 0.45,
    "enable_lane_detection": true,
    "enable_distance_estimation": true,
    "camera_height_m": 1.25,
    "camera_pitch_deg": 2.0,
    "focal_length_px": 920.0,
    "model": "yolo11s.pt",
    "use_cuda": true,
    "imgsz": 640
  },
  "sensors": {
    "esp32_port": "/dev/ttyUSB0",
    "baud_rate": 115200,
    "vibration_threshold_g": 2.2,
    "filter_cutoff_hz": 5.0,
    "update_hz": 20,
    "simulation_mode": false
  },
  "actuators": {
    "auto_buzzer_on_departure": true,
    "buzzer_pulse_ms": 250,
    "max_buzzer_duration_ms": 1500
  },
  "gui": {
    "theme": "dark",
    "fullscreen": false,
    "enable_map": true,
    "target_render_fps": 30
  }
}
