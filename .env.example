# KARP ADAS Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Network Configuration
KARP_LAPTOP_IP=192.168.1.100
KARP_PI_IP=192.168.1.101

# Video Stream Ports (RTP / UDP / TCP)
KARP_VIDEO_PORT_PI_TO_LAPTOP=5000
KARP_VIDEO_PORT_LAPTOP_TO_PI=5001

# Telemetry & Metadata WebSocket Port
KARP_METADATA_WS_PORT=8765

# Hardware: Raspberry Pi Camera
KARP_CAMERA_INDEX=0
KARP_VIDEO_WIDTH=1280
KARP_VIDEO_HEIGHT=720
KARP_VIDEO_FPS=30
KARP_VIDEO_BITRATE=2500000

# Hardware: ESP32 Serial Interface on Raspberry Pi
# Linux (Pi): /dev/ttyUSB0 or /dev/ttyACM0
# Windows (Laptop dev): COM3, COM4, etc.
KARP_ESP32_PORT=/dev/ttyUSB0
KARP_ESP32_BAUDRATE=115200

# ADAS Detection & Road Condition Parameters
KARP_CONFIDENCE_THRESHOLD=0.45
KARP_IOU_THRESHOLD=0.50
KARP_VIBRATION_THRESHOLD=2.20
KARP_SENSOR_UPDATE_HZ=20

# Execution & Acceleration Settings
KARP_USE_CUDA=true
KARP_FORCE_CPU=false
KARP_SIMULATION_MODE=false
KARP_LOG_LEVEL=INFO
